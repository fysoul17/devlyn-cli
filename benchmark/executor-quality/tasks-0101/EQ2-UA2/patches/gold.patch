 export class JobDedupIndex {
-  #slots = new Map();
+  #seen = new Set();
 
-  slotOf(jobId) {
-    return this.#slots.get(jobId);
+  has(jobId) {
+    return this.#seen.has(jobId);
   }
 
-  remember(jobId, slot) {
