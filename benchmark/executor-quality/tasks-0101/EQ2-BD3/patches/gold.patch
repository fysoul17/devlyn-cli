@@ -1,6 +1,27 @@
 """Apply ordered DNS record candidates before report ranking."""
 
+from models import normalize_change
+from record_order import order_changes
+from syntax_rules import syntax_issues
+
 
 def apply_changes(changes: list[dict]) -> dict:
     """Return raw placed changes and syntax/placement rejections."""
-    raise NotImplementedError("record application is not implemented")
+    normalized = [normalize_change(change) for change in changes]
+    placed: list[dict] = []
+    rejected: list[dict] = []
+    reserved: set[str] = set()
+
+    for source, change in order_changes(normalized):
+        issues = syntax_issues(change)
+        if issues:
+            rejected.append({"source": source, "issues": issues})
+            continue
+        owner = change["owner"]
+        if owner in reserved:
+            rejected.append({"source": source, "issues": ["occupied"]})
+            continue
+        reserved.add(owner)
+        placed.append(change)
+
+    return {"placed": placed, "rejected": rejected}
