--- a/rejection-policy.js
+++ b/rejection-policy.js
@@ -8,3 +8,15 @@
 export function rankRejections(rejections) {
-  return [...rejections];
+  const buckets = new Map(REASON_ORDER.map((reason) => [reason, []]));
+  for (const rejection of rejections) {
+    const bucket = buckets.get(rejection.reason);
+    const later = bucket.findIndex(
+      (candidate) => candidate.arrivalIndex > rejection.arrivalIndex,
+    );
+    if (later === -1) {
+      bucket.push(rejection);
+    } else {
+      bucket.splice(later, 0, rejection);
+    }
+  }
+  return REASON_ORDER.flatMap((reason) => buckets.get(reason));
 }
