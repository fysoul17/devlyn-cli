 "use strict";
 
+const { rankRequests } = require("./priority");
+const { WaveCursor } = require("./wave-cursor");
+
 function sequenceWaves(requests, policy, waveSize = 2) {
-  throw new Error("wave sequencing is not implemented");
+  const allowed = [];
+  const rejected = [];
+  for (const request of requests) {
+    if (policy.allows(request)) {
+      allowed.push(request);
+    } else {
+      rejected.push(request.id);
+    }
+  }
+
+  const cursor = new WaveCursor(waveSize);
