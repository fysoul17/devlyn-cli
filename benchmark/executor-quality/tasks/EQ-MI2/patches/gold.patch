--- a/playlist.py
+++ b/playlist.py
@@ -24,3 +24,18 @@
 def append_track(name: str, track_id: str) -> None:
     """Append one track to an existing playlist."""
     _playlists[name].append(track_id)
+
+
+def replace_tracks(
+    name: str,
+    track_ids: list[str],
+    catalog: dict[str, int],
+    max_seconds: int,
+) -> bool:
+    """Replace a playlist when every requested track fits the contract."""
+    if any(track_id not in catalog for track_id in track_ids):
+        return False
+    if sum(catalog[track_id] for track_id in track_ids) > max_seconds:
+        return False
+    _playlists[name] = list(track_ids)
+    return True
