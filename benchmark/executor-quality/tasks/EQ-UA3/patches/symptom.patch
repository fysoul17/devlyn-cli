+class PlanCommandTests(unittest.TestCase):
+    def test_plan_returns_available_destination(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            draft_path = root / "draft.json"
+            destinations_path = root / "destinations.json"
+            draft_path.write_text(
+                json.dumps({"title": "Weekly note", "slug": "weekly-note"}),
+                encoding="utf-8",
+            )
+            destinations_path.write_text(
+                json.dumps({"news": ["older-note"]}), encoding="utf-8"
+            )
+
+            completed = subprocess.run(
+                [
+                    sys.executable,
+                    str(ROOT / "cli.py"),
+                    "plan",
+                    str(draft_path),
+                    str(destinations_path),
+                    "news",
+                ],
+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                check=False,
+            )
+
+            self.assertEqual(completed.returncode, 0, completed.stderr)
+            self.assertEqual(
+                json.loads(completed.stdout),
+                {"channel": "news", "slug": "weekly-note"},
+            )
+
+
 if __name__ == "__main__":
     unittest.main()
