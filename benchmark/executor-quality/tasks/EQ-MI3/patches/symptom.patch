+def validate_bundle(documents: list[str]) -> dict[str, Any]:
+    """Validate bundle documents from first to last."""
+    names: list[str] = []
+    for text in documents:
+        result = validate_document(text)
+        if not result["ok"]:
+            return result
+        names.append(result["name"])
+    return {"ok": True, "names": names}
