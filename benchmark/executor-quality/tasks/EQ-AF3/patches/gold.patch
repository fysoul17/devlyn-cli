+
+def read_from_replicas(readers: list[Reader]) -> dict[str, Any]:
+    """Return the first record, preserving the strongest aggregate failure."""
+    unavailable: ReplicaUnavailable | None = None
+    corrupt: CorruptReplica | None = None
+    for reader in readers:
+        try:
+            return read_replica(reader)
+        except ReplicaUnavailable as exc:
+            if unavailable is None:
+                unavailable = exc
+        except CorruptReplica as exc:
+            if corrupt is None:
+                corrupt = exc
+        except RecordMissing:
+            continue
+
+    if unavailable is not None:
+        raise unavailable
+    if corrupt is not None:
+        raise corrupt
+    raise RecordMissing("record missing")
