+    def submit_batch(self, jobs: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """Submit jobs using the identifiers known at batch start."""
+        known_ids = set(self.records)
+        entries: list[dict[str, Any]] = []
+        for job in jobs:
+            job_id = job["job_id"]
+            if job_id in known_ids:
+                status = "duplicate"
+                result = self.records[job_id]
+            else:
+                status = "created"
+                result = {
+                    "sequence": self.total_processed + 1,
+                    "payload": job["payload"],
+                }
+                self.records[job_id] = result
+                self.total_processed += 1
+            entries.append(
+                {"job_id": job_id, "status": status, "result": result}
+            )
+        return entries
