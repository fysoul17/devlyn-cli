+    def test_batch_reuses_results_for_repeated_identifiers(self) -> None:
+        store = JobStore()
+
+        results = store.submit_batch(
+            [
+                {"job_id": "job-1", "payload": {"kind": "email"}},
+                {"job_id": "job-1", "payload": {"kind": "sms"}},
+            ]
+        )
