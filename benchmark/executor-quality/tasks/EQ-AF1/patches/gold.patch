+    def submit_batch(self, jobs: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """Submit jobs in order while preserving single-job identity semantics."""
+        entries: list[dict[str, Any]] = []
+        for job in jobs:
+            job_id = job["job_id"]
+            duplicate = job_id in self.records
+            result = self.submit_job(job_id, job["payload"])
+            entries.append(
+                {
+                    "job_id": job_id,
+                    "status": "duplicate" if duplicate else "created",
+                    "result": result,
+                }
+            )
+        return entries
