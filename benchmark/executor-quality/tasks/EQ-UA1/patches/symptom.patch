+class BatchCommandTests(unittest.TestCase):
+    def test_batch_restores_accounts_for_insufficient_funds(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            accounts_path = root / "accounts.json"
+            operations_path = root / "operations.json"
+            original = b'{"checking": 20}\n'
+            accounts_path.write_bytes(original)
+            operations_path.write_text(
+                json.dumps(
+                    [
+                        {"account": "checking", "delta": 5},
+                        {"account": "checking", "delta": -30},
+                    ]
+                ),
+                encoding="utf-8",
+            )
+
+            completed = subprocess.run(
+                [sys.executable, str(ROOT / "cli.py"), "batch", str(accounts_path), str(operations_path)],
+                text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+
+            self.assertEqual(completed.returncode, 1, completed.stderr)
+            self.assertEqual(accounts_path.read_bytes(), original)
+            self.assertEqual(json.loads(completed.stdout)["rejected"]["index"], 1)
+
+
 if __name__ == "__main__":
     unittest.main()
