+    def test_rotates_every_ciphertext(self) -> None:
+        keyring = Keyring("key-a")
+        keyring.add("mail", "cipher-a")
+        keyring.add("chat", "cipher-b")
+
+        count = keyring.rotate_key(
+            "key-b",
+            lambda name, ciphertext, old_key, new_key: (
+                f"{name}:{ciphertext}:{old_key}:{new_key}"
+            ),
+        )
+
+        self.assertEqual(count, 2)
+        self.assertEqual(keyring.active_key, "key-b")
+        self.assertEqual(keyring.completed_rotations, 1)
+        self.assertEqual(set(keyring.secrets), {"mail", "chat"})
+
 
