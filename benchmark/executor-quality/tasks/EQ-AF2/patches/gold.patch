@@ -22,3 +22,18 @@
         if name in self.secrets:
             raise ValueError(f"secret already exists: {name}")
         self.secrets[name] = ciphertext
+
+    def rotate_key(self, new_key: str, rewrap: Rewrapper) -> int:
+        """Publish a replacement key and ciphertext set after all rewrites succeed."""
+        replacements: dict[str, str] = {}
+        for name, ciphertext in self.secrets.items():
+            replacements[name] = rewrap(
+                name,
+                ciphertext,
+                self.active_key,
+                new_key,
+            )
+        self.secrets = replacements
+        self.active_key = new_key
+        self.completed_rotations += 1
+        return len(replacements)
