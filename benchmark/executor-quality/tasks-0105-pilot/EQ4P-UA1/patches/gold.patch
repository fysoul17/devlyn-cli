--- a/payload_window/allocator/swap_allocator.py
+++ b/payload_window/allocator/swap_allocator.py
@@ -6,6 +6,13 @@
 def apply_payload_swap(launch):
     previous = launch["allocation"]
+    launch.setdefault("prior_slot", previous)
     launch["allocation"] = launch["replacement"]
     record_swap(launch, previous)
+    if launch["hold"]:
+        launch["allocation"] = launch["prior_slot"]
+        launch["slot_open"] = False
+        if "hold" not in launch["notices"]:
+            launch["notices"].append("hold")
+        return {"accepted": False, "held": True}
     launch["slot_open"] = True
     return {"accepted": True, "held": False}
