+  const sourceBefore = state.counts[sourceId];
+  const targetBefore = state.counts[targetId];
+  if (!Number.isInteger(quantity) || quantity <= 0) {
+    return makeReceipt(false, sourceId, targetId, quantity, "quantity");
+  }
+  if (sourceBefore === undefined || targetBefore === undefined) {
+    return makeReceipt(false, sourceId, targetId, quantity, "location");
+  }
+  if (state.lockedPrecincts.has(sourceId) || state.lockedPrecincts.has(targetId)) {
+    return makeReceipt(false, sourceId, targetId, quantity, "locked");
+  }
