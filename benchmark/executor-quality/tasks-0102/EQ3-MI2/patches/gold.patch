+function completeDecline(state, assignment) {
+  if (!isAssignmentLocked(state, assignment.orderId)) {
+    return null;
+  }
+  if (!state.repooledOrderIds.has(assignment.orderId)) {
+    state.waitingOrders.push({ orderId: assignment.orderId, rank: assignment.rank });
+    state.repooledOrderIds.add(assignment.orderId);
+  }
+  return { orderId: assignment.orderId, rank: assignment.rank };
+}
