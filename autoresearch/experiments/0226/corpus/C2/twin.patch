+    def test_ttu_equal_deadlines_assignment_order(self):
+        cache = TLRUCache[str, tuple[int, str], int](
+            maxsize=3, ttu=lambda _k, value, _t: value[0], timer=Timer()
+        )
+        cache["a"] = (10, "A")
+        cache["b"] = (10, "B")
+        cache["c"] = (10, "C")
+
+        self.assertEqual((10, "A"), cache["a"])
+        self.assertIn("b", cache)
+        self.assertEqual(
+            [("a", (10, "A")), ("b", (10, "B")), ("c", (10, "C"))],
+            cache.expire(10),
+        )
+
+    def test_ttu_mixed_deadlines_assignment_order(self):
+        cache = TLRUCache[str, tuple[int, str], int](
+            maxsize=4, ttu=lambda _k, value, _t: value[0], timer=Timer()
+        )
+        cache["a"] = (10, "A")
+        cache["b"] = (5, "B")
+        cache["c"] = (10, "C")
+        cache["d"] = (5, "D")
+
+        self.assertEqual(
+            ["b", "d", "a", "c"], [key for key, _value in cache.expire(10)]
+        )
+
+    def test_ttu_equal_deadlines_after_deletion(self):
+        cache = TLRUCache(maxsize=3, ttu=lambda _k, _v, _t: 10, timer=Timer())
+        cache["a"] = "A"
+        cache["b"] = "B"
+        cache["c"] = "C"
+        del cache["b"]
+
+        self.assertEqual([("a", "A"), ("c", "C")], cache.expire(10))
+
+    def test_ttu_replacement_with_distinct_deadline(self):
+        cache = TLRUCache[str, tuple[int, str], int](
+            maxsize=2, ttu=lambda _k, value, _t: value[0], timer=Timer()
+        )
+        cache["a"] = (5, "old")
+        cache["b"] = (8, "B")
+        cache["a"] = (12, "new")
+
+        self.assertEqual([("b", (8, "B"))], cache.expire(8))
+        self.assertEqual([("a", (12, "new"))], cache.expire(12))
+
+    def test_ttu_equal_deadlines_nonorderable_keys(self):
+        cache = TLRUCache(maxsize=3, ttu=lambda _k, _v, _t: 10, timer=Timer())
+        keys = [object() for _ in range(3)]
+        for value, key in enumerate(keys):
