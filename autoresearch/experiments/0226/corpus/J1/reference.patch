 #### `string.truncate([enabled])`
 
 Specifies whether the `string.max()` limit should be used as a truncation.
+When the maximum uses UTF-8 encoding (`utf8` or `utf-8`, case-insensitive), truncation retains the longest prefix of complete code points that fits the byte limit.
 
 Parameters are:
 - `enabled` - optional parameter defaulting to `true` which allows you to reset the behavior of truncate by providing a falsy value.
diff --git a/lib/types/string.js b/lib/types/string.js
index 77578d5..425ce06 100755
--- a/lib/types/string.js
+++ b/lib/types/string.js
@@ -118,7 +118,28 @@ module.exports = Any.extend({
                         }
                     }
 
-                    value = value.slice(0, limit);
+                    const encoding = rule.args.encoding;
+
+                    if (encoding && ['utf8', 'utf-8'].includes(encoding.toLowerCase())) {
+                        let bytes = 0;
+                        let end = 0;
+
+                        for (const character of value) {
+                            const size = Buffer.byteLength(character, encoding);
+
+                            if (bytes + size > limit) {
+                                break;
+                            }
+
+                            bytes += size;
+                            end += character.length;
+                        }
+
+                        value = value.slice(0, end);
+                    }
+                    else {
+                        value = value.slice(0, limit);
+                    }
                 }
             }
 
