+            result, _ = self.cli("clean-scratch", "--receipt", self.receipt, "--writers-stopped")
+            self.assertEqual(result["status"], "SCRATCH_CLEAN")
+            self.assertFalse(any(scratch.iterdir()))
+        finally:
+            os.waitpid(child, 0)
