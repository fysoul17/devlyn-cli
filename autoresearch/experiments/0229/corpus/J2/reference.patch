+  /**
+   * Move an existing rule immediately before another rule. The rule keeps its
+   * enabled state and membership in additional chains. Throws if either rule
+   * is not found.
+   *
+   * @example
+   * ```javascript
+   * import MarkdownIt from 'markdown-it'
+   * const md = new MarkdownIt()
+   *
+   * md.core.ruler.moveBefore('my_rule', 'inline')
+   * ```
+   */
+  moveBefore (ruleName: string, beforeName: string): void {
+    const ruleIndex = this.__find__(ruleName)
+    if (ruleIndex === -1) { throw new Error(`Parser rule not found: ${ruleName}`) }
+
+    const beforeIndex = this.__find__(beforeName)
+    if (beforeIndex === -1) { throw new Error(`Parser rule not found: ${beforeName}`) }
+
+    if (ruleIndex === beforeIndex || ruleIndex + 1 === beforeIndex) return
+
+    const [rule] = this.__rules__.splice(ruleIndex, 1)
+    this.__rules__.splice(ruleIndex < beforeIndex ? beforeIndex - 1 : beforeIndex, 0, rule)
+    this.__cache__ = null
+  }
+
