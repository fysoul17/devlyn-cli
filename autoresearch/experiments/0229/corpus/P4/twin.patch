+
+@pytest.mark.parametrize("year", (2014, 2017))
+@pytest.mark.parametrize(
+    "fmt", ("{:04d}-W53", "{:04d}W53", "{:04d}-W53-1", "{:04d}W537")
+)
+def test_isoweek_invalid_for_year(year, fmt):
+    dtstr = fmt.format(year)
+    parser = isoparser()
+    for parse_fn in (isoparse, parser.isoparse, parser.parse_isodate):
+        with pytest.raises(ValueError):
+            parse_fn(dtstr)
+
+
+@pytest.mark.parametrize("year", (2014, 2017))
+@pytest.mark.parametrize(
+    "fmt", ("{:04d}-W53-1T12:34:56Z", "{:04d}W531T123456+02")
+)
+def test_isoweek_invalid_datetime_for_year(year, fmt):
+    dtstr = fmt.format(year)
+    parser = isoparser()
+    for parse_fn in (isoparse, parser.isoparse):
+        with pytest.raises(ValueError):
+            parse_fn(dtstr)
+
+
+@pytest.mark.parametrize(
+    "dtstr,expected",
+    (
+        ("2020-W01-1", date(2019, 12, 30)),
+        ("2014-W52-7", date(2014, 12, 28)),
+        ("2015-W53-7", date(2016, 1, 3)),
+        ("2020-W53", date(2020, 12, 28)),
+        ("2020-W53-7", date(2021, 1, 3)),
+    ),
+)
+def test_isoweek_parse_isodate(dtstr, expected):
+    parser = isoparser()
+    for value in (dtstr, dtstr.replace("-", "")):
+        assert parser.parse_isodate(value) == expected
+
+
+@pytest.mark.parametrize(
+    "dtstr",
+    (
+        "2020-W53-7T01:02:03.456789+02:30",
+        "2020W537T010203.456789+0230",
+    ),
+)
+def test_isoweek_datetime_fields(dtstr):
+    expected = datetime(2021, 1, 3, 1, 2, 3, 456789)
+    for parse_fn in (isoparse, isoparser().isoparse):
+        result = parse_fn(dtstr)
+        assert result.replace(tzinfo=None) == expected
+        assert result.utcoffset() == timedelta(hours=2, minutes=30)
+
+
+@pytest.mark.parametrize(
+    "dtstr,expected",
+    (
+        ("2020-W01-1T12:34", datetime(2019, 12, 30, 12, 34)),
+        ("2014W527T1234", datetime(2014, 12, 28, 12, 34)),
+    ),
+)
+def test_isoweek_datetime_spillover(dtstr, expected):
+    assert isoparse(dtstr) == expected
+
