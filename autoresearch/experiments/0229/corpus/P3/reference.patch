+
+class _GettzCacheZone(tzinfo):
+    def __init__(self, name):
+        self.name = name
+
+    def utcoffset(self, dt):
+        return timedelta(0)
+
+    def dst(self, dt):
+        return timedelta(0)
+
+    def tzname(self, dt):
+        return self.name
+
+
+class _GettzCacheSizeIndex(object):
+    def __init__(self, value):
+        self.value = value
+
+    def __index__(self):
+        return self.value
+
+
+def _isolated_gettz_cache(size=3):
+    getter = type(tz.gettz)()
+    getter.nocache = lambda name=None: _GettzCacheZone(name)
+    assert getter.set_cache_size(size) is None
+    return getter
+
+
+def _gettz_cache_refs(getter, names):
+    return {name: weakref.ref(getter(name)) for name in names}
+
+
+@pytest.mark.gettz
+@pytest.mark.parametrize(
+    "size,retained",
+    [
+        (0, ()),
+        (1, ("C",)),
+        (3, ("A", "B", "C")),
+        (False, ()),
+        (True, ("C",)),
+        (_GettzCacheSizeIndex(2), ("B", "C")),
+    ],
+)
+def test_gettz_cache_size_valid_inputs(size, retained):
+    getter = _isolated_gettz_cache()
+    assert getter.set_cache_size(size) is None
+    refs = _gettz_cache_refs(getter, ("A", "B", "C"))
+    gc.collect()
+    assert {name for name, ref in refs.items() if ref() is not None} == set(
+        retained
+    )
+
+
+@pytest.mark.gettz
+@pytest.mark.parametrize("size", (-1, _GettzCacheSizeIndex(-1)))
+def test_gettz_cache_size_negative_input(size):
+    getter = _isolated_gettz_cache()
+    with pytest.raises(ValueError):
+        getter.set_cache_size(size)
+
+
+@pytest.mark.gettz
+@pytest.mark.parametrize("size", (None, "3", 1.5, object()))
+def test_gettz_cache_size_invalid_type(size):
+    getter = _isolated_gettz_cache()
+    with pytest.raises(TypeError):
+        getter.set_cache_size(size)
+
+
+@pytest.mark.gettz
+def test_gettz_cache_size_index_exception():
+    failure = RuntimeError("conversion failed")
+
+    class BrokenIndex(object):
+        def __index__(self):
+            raise failure
+
+    getter = _isolated_gettz_cache()
+    with pytest.raises(RuntimeError) as raised:
+        getter.set_cache_size(BrokenIndex())
+    assert raised.value is failure
+
+
+@pytest.mark.gettz
+def test_gettz_cache_size_failed_conversion_preserves_order():
+    getter = _isolated_gettz_cache()
+    refs = _gettz_cache_refs(getter, ("A", "B", "C"))
+    assert getter("A") is refs["A"]()
+
+    with pytest.raises(TypeError):
+        getter.set_cache_size("2")
+
+    refs["D"] = weakref.ref(getter("D"))
+    gc.collect()
+    assert refs["B"]() is None
+    assert all(refs[name]() is not None for name in ("A", "C", "D"))
+
+    assert getter.set_cache_size(2) is None
+    gc.collect()
+    assert refs["C"]() is None
+    assert refs["A"]() is not None and refs["D"]() is not None
+
+
+@pytest.mark.gettz
+def test_gettz_cache_size_shrink_and_grow():
+    getter = _isolated_gettz_cache()
+    refs = _gettz_cache_refs(getter, ("A", "B", "C"))
+    assert getter("A") is refs["A"]()
+
+    assert getter.set_cache_size(_GettzCacheSizeIndex(2)) is None
+    gc.collect()
+    assert refs["B"]() is None
+    assert refs["A"]() is not None and refs["C"]() is not None
+
+    assert getter.set_cache_size(3) is None
+    refs["D"] = weakref.ref(getter("D"))
+    gc.collect()
+    assert all(refs[name]() is not None for name in ("C", "A", "D"))
+
+    refs["E"] = weakref.ref(getter("E"))
+    gc.collect()
+    assert refs["C"]() is None
+    assert all(refs[name]() is not None for name in ("A", "D", "E"))
+
+
+@pytest.mark.gettz
+def test_gettz_cache_size_zero_keeps_live_identity():
+    getter = _isolated_gettz_cache(2)
+    held = getter("A")
+    a_ref = weakref.ref(held)
+    b_ref = weakref.ref(getter("B"))
+
+    assert getter.set_cache_size(0) is None
+    gc.collect()
+    assert b_ref() is None
+    assert getter("A") is held
+
+    del held
+    gc.collect()
+    assert a_ref() is None
+
+
+@pytest.mark.gettz
+def test_gettz_cache_clear_isolated():
+    getter = _isolated_gettz_cache(1)
+    held = getter("A")
+    getter.cache_clear()
+    fresh = getter("A")
+    assert fresh is not held
+    fresh_ref = weakref.ref(fresh)
+    del fresh
+    getter("B")
+    gc.collect()
+    assert fresh_ref() is None
+
