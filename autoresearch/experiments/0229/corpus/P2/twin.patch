+@pytest.mark.parametrize("parse_fn", [parse, parser().parse])
+def test_tzinfos_pair_priority_fallback_and_ignoretz(parse_fn):
+    text = "2012-01-19 17:21:00 -0300 (BRST)"
+    name_text = "2012-01-19 17:21:00 BRST"
+    wall = datetime(2012, 1, 19, 17, 21)
+    pair_zone = tzoffset("PAIR", -7200)
+    name_zone = tzoffset("NAME", -14400)
+    tzinfos = {("BRST", -10800): pair_zone, "BRST": name_zone}
+
+    exact = parse_fn(text, tzinfos=tzinfos)
+    fallback = parse_fn(name_text, tzinfos=tzinfos)
+    ignored = parse_fn(text, tzinfos=tzinfos, ignoretz=True)
+
+    assert exact.tzinfo is pair_zone
+    assert fallback.tzinfo is name_zone
+    assert exact.replace(tzinfo=None) == wall
+    assert fallback.replace(tzinfo=None) == wall
+    assert ignored == wall
+    assert ignored.tzinfo is None
+
+
+@pytest.mark.parametrize(
+    "value,seconds",
+    [
+        (tzoffset("PAIR", -7200), -7200),
+        ("UTC+0", 0),
+        (3600, 3600),
+        (0, 0),
+    ],
+)
+def test_tzinfos_pair_conversions(value, seconds):
+    text = "2012-01-19 17:21:00 -0300 (BRST)"
+    result = parse(text, tzinfos={("BRST", -10800): value})
+
+    if isinstance(value, tz.tzoffset):
+        assert result.tzinfo is value
+    assert result.utcoffset() == timedelta(seconds=seconds)
+    assert result.replace(tzinfo=None) == datetime(2012, 1, 19, 17, 21)
+
+
+def test_tzinfos_pair_absent_components():
+    name_zone = tzoffset("NAME", -14400)
+    offset_zone = tzoffset("OFFSET", -7200)
+
+    name_result = parse(
+        "2012-01-19 17:21:00 BRST", tzinfos={("BRST", None): name_zone}
+    )
+    offset_result = parse(
+        "2012-01-19 17:21:00 -0300", tzinfos={(None, -10800): offset_zone}
+    )
+
+    assert name_result.tzinfo is name_zone
+    assert offset_result.tzinfo is offset_zone
+
+
+def test_tzinfos_pair_miss_uses_name_or_numeric_offset():
+    text = "2012-01-19 17:21:00 -0300 (BRST)"
+    pair_zone = tzoffset("PAIR", -7200)
+    name_zone = tzoffset("NAME", -14400)
+    tzinfos = {("BRST", 3600): pair_zone, "BRST": name_zone}
+
+    assert parse(text, tzinfos=tzinfos).tzinfo is name_zone
+    numeric = parse(
+        "2012-01-19 17:21:00 -0300", tzinfos={("BRST", 3600): pair_zone}
+    )
+    assert numeric.utcoffset() == timedelta(hours=-3)
+
+
+def test_tzinfos_pair_none_and_invalid_value():
+    text = "2012-01-19 17:21:00 -0300 (BRST)"
+    name_zone = tzoffset("NAME", -14400)
+
+    assert parse(text, tzinfos={("BRST", -10800): None}).tzinfo is None
+    with pytest.raises(TypeError):
+        parse(text, tzinfos={("BRST", -10800): object(), "BRST": name_zone})
+
+
+def test_tzinfos_pair_callback_and_ignoretz():
+    text = "2012-01-19 17:21:00 -0300 (BRST)"
+    calls = []
+    pair_zone = tzoffset("PAIR", -7200)
+
+    def resolve(name, offset):
+        calls.append((name, offset))
+        return pair_zone
+
+    assert parse(text, tzinfos=resolve).tzinfo is pair_zone
+    assert calls == [("BRST", -10800)]
+    assert parse(text, tzinfos=resolve, ignoretz=True) == datetime(
+        2012, 1, 19, 17, 21
+    )
+    assert calls == [("BRST", -10800)]
+
+
