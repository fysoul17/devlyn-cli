+function changeRules<Parser extends MarkdownIt> (
+  md: Parser,
+  list: string | string[],
+  ignoreInvalid: boolean,
+  operation: 'enable' | 'disable'
+): Parser {
+  const names = Array.isArray(list) ? list : [list]
+  const primaryRulers = [md.core.ruler, md.block.ruler, md.inline.ruler]
+  const rulers = [...primaryRulers, md.inline.ruler2]
+
+  if (!ignoreInvalid) {
+    const missed = names.filter(name => rulers.every(ruler => ruler.__find__(name) < 0))
+    if (missed.length) {
+      throw new Error(`MarkdownIt. Failed to ${operation} unknown rule(s): ${missed}`)
+    }
+  }
+
+  primaryRulers.forEach(ruler => { ruler[operation](names, true) })
+  md.inline.ruler2[operation](names, true)
+  return md
+}
+
 export default MarkdownIt
