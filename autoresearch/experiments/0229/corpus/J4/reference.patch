diff --git a/src/rules_block/reference.ts b/src/rules_block/reference.ts
index 5cbb289..1a9665f 100644
--- a/src/rules_block/reference.ts
+++ b/src/rules_block/reference.ts
@@ -208,14 +208,16 @@ export default function reference (state: StateBlock, startLine: number, _endLin
     state.env.references[label] = { title, href }
   }
 
-  // Marks the place definition took in the source. Renders to nothing,
-  // href/title stay in `env.references`.
+  // Marks the place definition took in the source. Renders to nothing;
+  // the token snapshots this definition's values alongside the lookup entry.
   const token = state.push('reference_definition', '', 0)
   token.map = [startLine, nextLine]
   token.hidden = true
 
   const meta: Record<string, unknown> = Object.create(null)
   meta.label = label
+  meta.href = href
+  meta.title = title
   token.meta = meta
 
   state.line = nextLine
