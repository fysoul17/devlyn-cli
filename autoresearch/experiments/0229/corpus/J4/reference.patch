+    const src = '[Foo  Bar]: </a b> "A &amp; B"\n\n[go][foo bar]\n'
+    const env = {}
+    const tokens = md.parse(src, env)
+    const definitions = tokens.filter(t => t.type === 'reference_definition')
+    const expectedMeta = Object.create(null)
+    expectedMeta.label = 'FOO BAR'
