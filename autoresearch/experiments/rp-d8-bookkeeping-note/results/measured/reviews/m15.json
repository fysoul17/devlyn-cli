       "deletions": 3,
       "filename": "src/limitcli/__init__.py",
       "patch": "@@ -4,8 +4,8 @@\n \n def parse_limit(argv=None):\n     parser = argparse.ArgumentParser()\n-    parser.add_argument(\"--limit\", type=int)\n+    parser.add_argument(\"--limit\", type=int, default=10)\n     args = parser.parse_args(argv)\n-    if args.limit is not None and args.limit < 0:\n+    if args.limit < 0:\n         parser.error(\"--limit must be nonnegative\")\n-    return args.limit or 10\n+    return args.limit",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m15/raw/239887e9a7ea0137696d1755fac74f9b2a29b00f/src%2Flimitcli%2F__init__.py",
       "sha": "0ec0d579c392a79bc4a27a6953c31b7423a62fc8",
       "status": "modified"
      },
      {
       "additions": 21,
       "blob_url": "https://github.com/fysoul17/rpd8-20261019a-m15/blob/239887e9a7ea0137696d1755fac74f9b2a29b00f/tests%2Ftest_regression.py",
       "changes": 21,
       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m15/contents/tests%2Ftest_regression.py?ref=239887e9a7ea0137696d1755fac74f9b2a29b00f",
       "deletions": 0,
       "filename": "tests/test_regression.py",
       "patch": "@@ -0,0 +1,21 @@\n+import pytest\n+\n+from limitcli import parse_limit\n+\n+\n+def test_zero_limit_is_preserved():\n+    assert parse_limit([\"--limit\", \"0\"]) == 0\n+\n+\n+def test_omitted_limit_defaults_to_ten():\n+    assert parse_limit([]) == 10\n+\n+\n+@pytest.mark.parametrize(\n+    \"argv\",\n+    [[\"--limit\"], [\"--unknown\"], [\"--limit\", \"-5\"], [\"--limit\", \"x\"]],\n+)\n+def test_invalid_arguments_exit_with_usage_error(argv):\n+    with pytest.raises(SystemExit) as caught:\n+        parse_limit(argv)\n+    assert caught.value.code == 2",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m15/raw/239887e9a7ea0137696d1755fac74f9b2a29b00f/tests%2Ftest_regression.py",
