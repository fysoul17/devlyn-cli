       "blob_url": "https://github.com/fysoul17/rpd8-20261019a-m04/blob/d8bdcc42be204e1f5ab803e6268d9a16ec6193ff/src%2Flimitcli%2F__init__.py",
       "changes": 6,
       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m04/contents/src%2Flimitcli%2F__init__.py?ref=d8bdcc42be204e1f5ab803e6268d9a16ec6193ff",
       "deletions": 3,
       "filename": "src/limitcli/__init__.py",
       "patch": "@@ -4,8 +4,8 @@\n \n def parse_limit(argv=None):\n     parser = argparse.ArgumentParser()\n-    parser.add_argument(\"--limit\", type=int)\n+    parser.add_argument(\"--limit\", type=int, default=10)\n     args = parser.parse_args(argv)\n-    if args.limit is not None and args.limit < 0:\n+    if args.limit < 0:\n         parser.error(\"--limit must be nonnegative\")\n-    return args.limit or 10\n+    return args.limit",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m04/raw/d8bdcc42be204e1f5ab803e6268d9a16ec6193ff/src%2Flimitcli%2F__init__.py",
       "sha": "0ec0d579c392a79bc4a27a6953c31b7423a62fc8",
       "status": "modified"
      },
      {
       "additions": 33,
       "blob_url": "https://github.com/fysoul17/rpd8-20261019a-m04/blob/d8bdcc42be204e1f5ab803e6268d9a16ec6193ff/tests%2Ftest_regression.py",
       "changes": 33,
       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m04/contents/tests%2Ftest_regression.py?ref=d8bdcc42be204e1f5ab803e6268d9a16ec6193ff",
       "deletions": 0,
       "filename": "tests/test_regression.py",
       "patch": "@@ -0,0 +1,33 @@\n+import pytest\n+\n+from limitcli import parse_limit\n+\n+\n+def test_zero_limit_stays_zero():\n+    assert parse_limit([\"--limit\", \"0\"]) == 0\n+    assert parse_limit([\"--limit=0\"]) == 0\n+\n+\n+def test_omitted_limit_defaults_to_ten():\n+    assert parse_limit([]) == 10\n+\n+\n+@pytest.mark.parametrize(\"value\", [\"1\", \"10\", \"25\"])\n+def test_positive_limits_preserved(value):\n+    assert parse_limit([\"--limit\", value]) == int(value)\n+\n+\n+@pytest.mark.parametrize(\n+    \"argv\",\n+    [\n+        [\"--limit\", \"-1\"],\n+        [\"--limit\", \"bad\"],\n+        [\"--limit\", \"1.5\"],\n+        [\"--limit\"],\n+        [\"--unknown\"],\n+    ],\n+)\n+def test_invalid_arguments_exit_with_usage_error(argv):\n+    with pytest.raises(SystemExit) as caught:\n+        parse_limit(argv)\n+    assert caught.value.code == 2",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m04/raw/d8bdcc42be204e1f5ab803e6268d9a16ec6193ff/tests%2Ftest_regression.py",
       "sha": "3308fed7a9aec77735c29940797b45f6a3b89fee",
       "status": "added"
      }
