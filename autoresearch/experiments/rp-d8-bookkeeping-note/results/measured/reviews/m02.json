       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m02/contents/src%2Flimitcli%2F__init__.py?ref=7a63870b785832f52ca6ec5495c838d14ff55309",
       "deletions": 3,
       "filename": "src/limitcli/__init__.py",
       "patch": "@@ -4,8 +4,8 @@\n \n def parse_limit(argv=None):\n     parser = argparse.ArgumentParser()\n-    parser.add_argument(\"--limit\", type=int)\n+    parser.add_argument(\"--limit\", type=int, default=10)\n     args = parser.parse_args(argv)\n-    if args.limit is not None and args.limit < 0:\n+    if args.limit < 0:\n         parser.error(\"--limit must be nonnegative\")\n-    return args.limit or 10\n+    return args.limit",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m02/raw/7a63870b785832f52ca6ec5495c838d14ff55309/src%2Flimitcli%2F__init__.py",
       "sha": "0ec0d579c392a79bc4a27a6953c31b7423a62fc8",
       "status": "modified"
      },
      {
       "additions": 24,
       "blob_url": "https://github.com/fysoul17/rpd8-20261019a-m02/blob/7a63870b785832f52ca6ec5495c838d14ff55309/tests%2Ftest_regression.py",
       "changes": 24,
       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m02/contents/tests%2Ftest_regression.py?ref=7a63870b785832f52ca6ec5495c838d14ff55309",
       "deletions": 0,
       "filename": "tests/test_regression.py",
       "patch": "@@ -0,0 +1,24 @@\n+import pytest\n+\n+from limitcli import parse_limit\n+\n+\n+def test_zero_limit_stays_zero():\n+    assert parse_limit([\"--limit\", \"0\"]) == 0\n+    assert parse_limit([\"--limit=0\"]) == 0\n+\n+\n+def test_omitted_and_positive_limits():\n+    assert parse_limit([]) == 10\n+    assert parse_limit([\"--limit\", \"1\"]) == 1\n+    assert parse_limit([\"--limit\", \"25\"]) == 25\n+\n+\n+@pytest.mark.parametrize(\n+    \"argv\",\n+    [[\"--limit\", \"-1\"], [\"--limit\", \"bad\"], [\"--limit\", \"1.5\"], [\"--limit\"], [\"--unknown\"]],\n+)\n+def test_argparse_errors(argv):\n+    with pytest.raises(SystemExit) as caught:\n+        parse_limit(argv)\n+    assert caught.value.code == 2",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m02/raw/7a63870b785832f52ca6ec5495c838d14ff55309/tests%2Ftest_regression.py",
       "sha": "680d04abdd574c69c66c44a7565ffdd378f90167",
       "status": "added"
      }
