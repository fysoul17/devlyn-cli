       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m13/contents/src%2Flimitcli%2F__init__.py?ref=cb404c4a58a518b68a925cd89d3b856c420bace5",
       "deletions": 3,
       "filename": "src/limitcli/__init__.py",
       "patch": "@@ -4,8 +4,8 @@\n \n def parse_limit(argv=None):\n     parser = argparse.ArgumentParser()\n-    parser.add_argument(\"--limit\", type=int)\n+    parser.add_argument(\"--limit\", type=int, default=10)\n     args = parser.parse_args(argv)\n-    if args.limit is not None and args.limit < 0:\n+    if args.limit < 0:\n         parser.error(\"--limit must be nonnegative\")\n-    return args.limit or 10\n+    return args.limit",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m13/raw/cb404c4a58a518b68a925cd89d3b856c420bace5/src%2Flimitcli%2F__init__.py",
       "sha": "0ec0d579c392a79bc4a27a6953c31b7423a62fc8",
       "status": "modified"
      },
      {
       "additions": 22,
       "blob_url": "https://github.com/fysoul17/rpd8-20261019a-m13/blob/cb404c4a58a518b68a925cd89d3b856c420bace5/tests%2Ftest_regression.py",
       "changes": 22,
       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m13/contents/tests%2Ftest_regression.py?ref=cb404c4a58a518b68a925cd89d3b856c420bace5",
       "deletions": 0,
       "filename": "tests/test_regression.py",
       "patch": "@@ -0,0 +1,22 @@\n+import pytest\n+\n+from limitcli import parse_limit\n+\n+\n+def test_zero_limit_stays_zero():\n+    assert parse_limit([\"--limit\", \"0\"]) == 0\n+    assert parse_limit([\"--limit=0\"]) == 0\n+\n+\n+def test_omitted_limit_defaults_to_ten():\n+    assert parse_limit([]) == 10\n+\n+\n+@pytest.mark.parametrize(\n+    \"argv\",\n+    [[\"--limit\", \"-1\"], [\"--limit\", \"bad\"], [\"--limit\", \"1.5\"], [\"--limit\"], [\"--unknown\"]],\n+)\n+def test_invalid_arguments_exit_with_usage_error(argv):\n+    with pytest.raises(SystemExit) as caught:\n+        parse_limit(argv)\n+    assert caught.value.code == 2",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m13/raw/cb404c4a58a518b68a925cd89d3b856c420bace5/tests%2Ftest_regression.py",
