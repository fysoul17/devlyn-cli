      },
      {
       "additions": 19,
       "blob_url": "https://github.com/fysoul17/rpd8-20261019a-m01/blob/31fb4806739dc27b79e28dffaaefe7cbc65b4db4/tests%2Ftest_regression.py",
       "changes": 19,
       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m01/contents/tests%2Ftest_regression.py?ref=31fb4806739dc27b79e28dffaaefe7cbc65b4db4",
       "deletions": 0,
       "filename": "tests/test_regression.py",
       "patch": "@@ -0,0 +1,19 @@\n+import pytest\n+\n+from limitcli import parse_limit\n+\n+\n+def test_zero_limit_stays_zero():\n+    assert parse_limit([\"--limit\", \"0\"]) == 0\n+    assert parse_limit([\"--limit=0\"]) == 0\n+\n+\n+def test_omitted_limit_defaults_to_ten():\n+    assert parse_limit([]) == 10\n+\n+\n+@pytest.mark.parametrize(\"argv\", [[\"--limit\"], [\"--unknown\"], [\"--limit\", \"-5\"]])\n+def test_argparse_errors(argv):\n+    with pytest.raises(SystemExit) as caught:\n+        parse_limit(argv)\n+    assert caught.value.code == 2",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m01/raw/31fb4806739dc27b79e28dffaaefe7cbc65b4db4/tests%2Ftest_regression.py",
