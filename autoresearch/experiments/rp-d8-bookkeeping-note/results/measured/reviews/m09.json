      },
      {
       "additions": 25,
       "blob_url": "https://github.com/fysoul17/rpd8-20261019a-m09/blob/18c3409092145567baa237fd24ef81e5cbaa2f7f/tests%2Ftest_regression.py",
       "changes": 25,
       "contents_url": "https://api.github.com/repos/fysoul17/rpd8-20261019a-m09/contents/tests%2Ftest_regression.py?ref=18c3409092145567baa237fd24ef81e5cbaa2f7f",
       "deletions": 0,
       "filename": "tests/test_regression.py",
       "patch": "@@ -0,0 +1,25 @@\n+import pytest\n+\n+from limitcli import parse_limit\n+\n+\n+def test_zero_limit_is_preserved():\n+    assert parse_limit([\"--limit\", \"0\"]) == 0\n+\n+\n+def test_omitted_limit_defaults_to_ten():\n+    assert parse_limit([]) == 10\n+\n+\n+def test_positive_limit_is_preserved():\n+    assert parse_limit([\"--limit\", \"1\"]) == 1\n+\n+\n+@pytest.mark.parametrize(\n+    \"argv\",\n+    [[\"--limit\", \"-1\"], [\"--limit\", \"bad\"], [\"--limit\", \"1.5\"], [\"--limit\"], [\"--unknown\"]],\n+)\n+def test_invalid_arguments_exit_with_usage_error(argv):\n+    with pytest.raises(SystemExit) as caught:\n+        parse_limit(argv)\n+    assert caught.value.code == 2",
       "raw_url": "https://github.com/fysoul17/rpd8-20261019a-m09/raw/18c3409092145567baa237fd24ef81e5cbaa2f7f/tests%2Ftest_regression.py",
       "sha": "34f46ef6bf405150717d30566f918abb7be1535a",
       "status": "added"
      }
