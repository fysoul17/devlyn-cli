       "deletions": 0,
       "filename": "tests/test_regression.py",
       "patch": "@@ -0,0 +1,16 @@\n+import pytest\n+\n+from limitcli import parse_limit\n+\n+\n+def test_zero_limit_is_preserved():\n+    assert parse_limit([\"--limit\", \"0\"]) == 0\n+    assert parse_limit([]) == 10\n+    assert parse_limit([\"--limit\", \"3\"]) == 3\n+\n+\n+@pytest.mark.parametrize(\"argv\", [[\"--limit\", \"-1\"], [\"--limit\", \"bad\"], [\"--limit\"], [\"--unknown\"]])\n+def test_invalid_arguments_keep_argparse_exit(argv):\n+    with pytest.raises(SystemExit) as caught:\n+        parse_limit(argv)\n+    assert caught.value.code == 2",
