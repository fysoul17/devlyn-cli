+    def test_force_refresh_and_cache(self):
+        """
+        A forced resolution refreshes types and replaces the cached result.
+        """
+
+        @attrs.define
+        class C:
+            value: "Token"  # noqa: F821
+
+        assert C is attrs.resolve_types(C, localns={"Token": int})
+        assert int is attrs.fields(C).value.type
+
+        assert C is attrs.resolve_types(C, localns={"Token": str})
+        assert int is attrs.fields(C).value.type
+
+        assert C is attrs.resolve_types(C, localns={"Token": str}, force=True)
+        assert str is attrs.fields(C).value.type
+        assert C is C.__dict__["__attrs_types_resolved__"]
+
+        assert C is attrs.resolve_types(C, localns={"Token": float})
+        assert str is attrs.fields(C).value.type
+
+        assert C is attrs.resolve_types(
+            C, localns={"Token": float}, force=True
+        )
+        assert float is attrs.fields(C).value.type
+        assert C is C.__dict__["__attrs_types_resolved__"]
+
+    def test_force_refresh_extras_and_unannotated_field(self):
+        """
+        Refreshing can change extras without changing unannotated fields.
+        """
+
+        @attr.s
+        class C:
+            value: "Annotated[int, 'tag']" = attr.ib()  # noqa: F821
+            other = attr.ib(type=str)
+
+        namespace = {"Annotated": typing.Annotated}
+        value, other = attr.fields(C)
+
+        assert C is attr.resolve_types(C, globalns=namespace)
+        assert typing.Annotated[int, "tag"] == value.type
+        assert str is other.type
+
+        assert C is attr.resolve_types(
+            C, globalns=namespace, include_extras=False, force=True
+        )
+        assert int is value.type
+        assert str is other.type
+
+        assert C is attr.resolve_types(
+            C, globalns=namespace, include_extras=True, force=True
+        )
+        assert typing.Annotated[int, "tag"] == value.type
+        assert str is other.type
+
+    def test_force_refresh_inherited_fields(self):
+        """
+        A resolved base does not mark its subclass as resolved.
+        """
+
+        @attrs.define
+        class Base:
+            value: "Token"  # noqa: F821
+
+        assert Base is attr.resolve_types(Base, localns={"Token": int})
+
+        @attrs.define
+        class Child(Base):
+            extra: "Token"  # noqa: F821
+
+        assert Child is attr.resolve_types(Child, localns={"Token": str})
+        assert str is attr.fields(Child).value.type
+        assert str is attr.fields(Child).extra.type
+
+        assert Child is attr.resolve_types(
+            Child, localns={"Token": float}, force=True
+        )
+        assert float is attr.fields(Child).value.type
+        assert float is attr.fields(Child).extra.type
+        assert Child is Child.__dict__["__attrs_types_resolved__"]
+        assert int is attr.fields(Base).value.type
+        assert Base is Base.__dict__["__attrs_types_resolved__"]
+
+    def test_force_refresh_in_field_transformer(self):
+        """
+        Explicit attributes can be refreshed before decoration completes.
+        """
+
+        def transform(cls, attribs):
+            assert not attr.has(cls)
+            assert cls is attr.resolve_types(
+                cls, localns={"Token": int}, attribs=attribs
+            )
+            assert cls is attr.resolve_types(
+                cls, localns={"Token": float}, attribs=attribs, force=True
+            )
+            return attribs
+
+        @attr.s(field_transformer=transform)
+        class C:
+            value: "Token" = attr.ib()  # noqa: F821
+            other = attr.ib(type=str)
+
+        assert float is attr.fields(C).value.type
+        assert str is attr.fields(C).other.type
+        instance = C(2.5, "x")
+        assert (2.5, "x") == (instance.value, instance.other)
+
+    def test_resolve_after_initial_failure(self):
+        """
+        A failed initial evaluation leaves fields ready for a later retry.
+        """
+
+        @attr.s
+        class C:
+            known: "int" = attr.ib()
+            unknown: "Missing" = attr.ib()  # noqa: F821
+
+        fields = attr.fields(C)
+        original_types = tuple(field.type for field in fields)
+        had_marker = "__attrs_types_resolved__" in C.__dict__
+
+        with pytest.raises(NameError):
+            attr.resolve_types(C, localns={})
+
+        assert original_types == tuple(field.type for field in fields)
+        assert had_marker == ("__attrs_types_resolved__" in C.__dict__)
+
+        assert C is attr.resolve_types(C, localns={"Missing": str})
+        assert int is fields.known.type
+        assert str is fields.unknown.type
+        assert C is C.__dict__["__attrs_types_resolved__"]
