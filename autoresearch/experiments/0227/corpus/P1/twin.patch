+@attrs(repr=False, frozen=True, slots=True)
+class _BetweenValidator:
+    lower = attrib()
+    upper = attrib()
+    lower_inclusive = attrib()
+    upper_inclusive = attrib()
+
+    def _interval(self):
+        left = "[" if self.lower_inclusive else "("
+        right = "]" if self.upper_inclusive else ")"
+        return f"{left}{self.lower!r}, {self.upper!r}{right}"
+
+    def __call__(self, inst, attr, value):
+        if (
+            value < self.lower if self.lower_inclusive else value <= self.lower
+        ) or (
+            value > self.upper if self.upper_inclusive else value >= self.upper
+        ):
+            msg = f"'{attr.name}' must be in {self._interval()}: {value!r}"
+            raise ValueError(msg)
+
+    def __repr__(self):
+        return f"<between validator for {self._interval()}>"
+
+
+def between(lower, upper, *, lower_inclusive=True, upper_inclusive=True):
+    """
+    A validator that raises `ValueError` if a value is outside an interval.
+
+    Comparisons use the value's ordering operators without conversion.
+
+    Args:
+        lower: Lower bound for values.
+        upper: Upper bound for values.
+        lower_inclusive (bool): Whether to accept the lower bound itself.
+        upper_inclusive (bool): Whether to accept the upper bound itself.
+
+    Raises:
+        ValueError: If *lower* is greater than *upper* when constructed, or a
+            value is outside the interval when validated.
+        TypeError: If the bounds or value cannot be compared.
+    """
+    if not lower <= upper:
+        msg = f"Lower bound {lower!r} must be <= upper bound {upper!r}"
+        raise ValueError(msg)
+
+    return _BetweenValidator(lower, upper, lower_inclusive, upper_inclusive)
+
+
