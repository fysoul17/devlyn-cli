+class TestBetween:
+    def test_exports(self):
+        assert "between" in validator_module.__all__
+        assert attr.validators.between is between
+        assert attrs.validators.between is between
+
+    @pytest.mark.parametrize(
+        ("lower_inclusive", "upper_inclusive", "interval"),
+        [
+            (True, True, "[2, 7]"),
+            (True, False, "[2, 7)"),
+            (False, True, "(2, 7]"),
+            (False, False, "(2, 7)"),
+        ],
+    )
+    def test_endpoints(self, lower_inclusive, upper_inclusive, interval):
+        v = between(
+            2,
+            7,
+            lower_inclusive=lower_inclusive,
+            upper_inclusive=upper_inclusive,
+        )
+        field = simple_attr("value")
+
+        assert repr(v) == f"<between validator for {interval}>"
+        for value, accepted in (
+            (1, False),
+            (2, lower_inclusive),
+            (4, True),
+            (7, upper_inclusive),
+            (8, False),
+        ):
+            if accepted:
+                assert v(None, field, value) is None
+            else:
+                with pytest.raises(ValueError) as exc:
+                    v(None, field, value)
+                assert "value" in str(exc.value)
+                assert interval in str(exc.value)
+                assert repr(value) in str(exc.value)
+
+    @pytest.mark.parametrize(
+        ("lower_inclusive", "upper_inclusive"),
+        [(True, True), (True, False), (False, True), (False, False)],
+    )
+    def test_equal_bounds(self, lower_inclusive, upper_inclusive):
+        v = between(
+            5,
+            5,
+            lower_inclusive=lower_inclusive,
+            upper_inclusive=upper_inclusive,
+        )
+        field = simple_attr("value")
+
+        for value in (4, 5, 6):
+            if value == 5 and lower_inclusive and upper_inclusive:
+                assert v(None, field, value) is None
+            else:
+                with pytest.raises(ValueError):
+                    v(None, field, value)
+
+    def test_reversed_bounds(self):
+        with pytest.raises(ValueError):
+            between(7, 2)
+
+    def test_infinite_bounds(self):
+        lower = -float("inf")
+        upper = float("inf")
+        field = simple_attr("value")
+        closed = between(lower, upper)
+        opened = between(
+            lower, upper, lower_inclusive=False, upper_inclusive=False
+        )
+
+        for value in (lower, 0, upper):
+            assert closed(None, field, value) is None
+
+        assert opened(None, field, 0) is None
+        for value in (lower, upper):
+            with pytest.raises(ValueError):
+                opened(None, field, value)
+
+    def test_comparison_error_propagates(self):
+        with pytest.raises(TypeError):
+            between(2, 7)(None, simple_attr("value"), 1j)
+
+    def test_equality_and_hash(self):
+        first = between(2, 7)
+        second = between(2, 7)
+
+        assert first == second
+        assert hash(first) == hash(second)
+        assert first != between(2, 7, upper_inclusive=False)
+
+    def test_field_validation(self):
+        @attrs.define
+        class Sample:
+            value: int = attrs.field(validator=between(2, 7))
+
+        with pytest.raises(ValueError):
+            Sample(8)
+
+        sample = Sample(4)
+        with pytest.raises(ValueError):
+            sample.value = 8
+        assert sample.value == 4
+
+        sample.value = 7
+        assert sample.value == 7
+
+    def test_optional_and_disabled(self):
+        @attrs.define
+        class Sample:
+            value: int = attrs.field(validator=between(2, 7))
+
+        @attrs.define
+        class OptionalSample:
+            value: int | None = attrs.field(validator=optional(between(2, 7)))
+
+        assert OptionalSample(None).value is None
+        assert OptionalSample(4).value == 4
+        with pytest.raises(ValueError):
+            OptionalSample(8)
+
+        with attrs.validators.disabled():
+            sample = Sample(8)
+        with pytest.raises(ValueError):
+            attrs.validate(sample)
+
